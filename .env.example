# Google Gemini API Key (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_free_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash

# RapidAPI JSearch API Key (Free tier available: https://rapidapi.com/letscrape-6bRBa3qigOq/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_jsearch_key

# Database Path
DATABASE_PATH=database/applications.db

# Notifications (Optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Submitter Browser Settings
HEADLESS=true
USER_DATA_DIR=.browser_profile
